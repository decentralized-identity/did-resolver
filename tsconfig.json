{
  "compilerOptions": {
    "target": "es2024",
    "module": "nodenext",
    "lib": ["es2024"],
    "outDir": "lib/esm",
    "rootDir": "src",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["src"],
  "exclude": ["src/__tests__", "node_modules", "lib"]
}
