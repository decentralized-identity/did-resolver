{
  "name": "did-resolver",
  "version": "5.0.1",
  "description": "Resolve DID documents",
  "source": "src/index.ts",
  "main": "./lib/index.cjs",
  "module": "./lib/index.mjs",
  "types": "./lib/index.d.ts",
  "type": "module",
  "files": [
    "lib",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "require": {
        "types": "./lib/index.d.cts",
        "default": "./lib/index.cjs"
      },
      "import": {
        "types": "./lib/index.d.mts",
        "default": "./lib/index.mjs"
      }
    }
  },
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/decentralized-identity/did-resolver.git"
  },
  "author": "Pelle Braendgaard",
  "contributors": [
    "Mircea Nistor <work@mirceanis.xyz>",
    "Jack Tanner <jack+public@tonomy.foundation>",
    "Rebal Alhaqash <rebal@tonomy.foundation>"
  ],
  "license": "Apache-2.0",
  "scripts": {
    "test": "vitest run",
    "test:ci": "vitest run --coverage",
    "clean": "rm -rf lib",
    "build": "tsc && tsc -p tsconfig.cjs.json && node scripts/postbuild.mjs",
    "format": "prettier --write \"src/**/*.[jt]s\"",
    "lint": "eslint \"src/**/*.[jt]s\"",
    "changeset": "changeset",
    "release:publish": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@typescript-eslint/eslint-plugin": "8.70.0",
    "@typescript-eslint/parser": "8.70.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/coverage-v8": "5.0.1",
    "@vitest/eslint-plugin": "1.6.27",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "prettier": "3.9.6",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "5.0.1"
  },
  "packageManager": "pnpm@12.4.2"
}
